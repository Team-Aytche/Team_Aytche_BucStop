@{
    ViewData["Title"] = "Game Criteria";
}



<!-- the game criteria-->
<p>In order to have your game listed on BucStop, it must meet the following criteria: The game must have a name that is not offensive and is less than 50 characters long. It must have controls that work on both PC and mobile, with a recommendation to use arrow keys since the site maps swipes to those keys. The game must not contain any offensive material, including expletives, gore, excessive violence, controlled substances, suggestive content, racially insensitive material, illegal content, or anything that could give a negative impression of the school. It must be written in JavaScript, contain no advertisements, and must not include any software that could be deemed malicious. The game must avoid excessive flashing lights or loud sounds, must not infringe on any copyrighted material, and must not exceed a total file size of 10MB, including images, sounds, and other assets. The game canvas must be within 640px by 640px. Additionally, it must not collect user data beyond the bare minimum required to save progress, and any non-JavaScript files necessary for the game to run must be included in a folder.</p>

<hr>

<h1>Submit your game</h1>

<form>
    <label>Your Name</label><br> <!--Added br after labels to fix spacing-->
    <input type="text" id="name" name="name" required>
    <br><br>

    <label>Game Title</label><br>
    <input type="text" id="game_title" name="game_title" required>
    <br><br>

    <div>
        <label for="GameDescrip">Game Description (Max 500 Characters):</label><br />
        <textarea id="GameDescrip" name="GameDescrip" maxlength="500"></textarea>
    </div>
    <br>

    <div>
        <label for="HowToPlay">How to Play (Max 500 Characters):</label><br />
        <textarea id="HowToPlay" name="HowToPlay" maxlength="500"></textarea>
    </div>
    <br>

    <label>Please enter a valid ETSU Email Prefix (e.g., username):</label><br>
    <div style="display: flex;">
        <input type="text" id="ETSUEmailPrefix" name="ETSUEmailPrefix" maxlength="30" required>
        <span style="color: white;">&#64;etsu.edu</span> </div>
    <br>

    <label>Please enter a valid GitHub link (e.g., https://github.com/yourusername/yourrepo):</label><br>
    <input type="url" id="GitHubLink" name="GitHubLink" pattern="https://github\.com/.*" title="Please enter a valid GitHub link (e.g., https://github.com/yourusername/yourrepo)" required>
    <br><br>

    <button type="submit" style="background: #FFC72C; border-radius:4px">Submit</button>
</form>

<div id="successMessage" style="display: none; color: green;">
    Submission Successful!
</div>

<script>
    document.querySelector("form").addEventListener("submit", function (event) {
        event.preventDefault();

        const name = document.getElementById("name").value;
        const gameTitle = document.getElementById("game_title").value;
        const gameDescription = document.getElementById("GameDescrip").value;
        const howToPlay = document.getElementById("HowToPlay").value;
        const prefixInput = document.getElementById("ETSUEmailPrefix").value;
        const gitHubLink = document.getElementById("GitHubLink").value;

        // Validate inputs
        if (!name || !gameTitle || !gameDescription || !howToPlay || !prefixInput || !gitHubLink) {
            alert("Please fill in all fields.");
            return;
        }

        if (!/^[a-zA-Z0-9]+$/.test(prefixInput)) {
            alert("Please enter a valid ETSU username (letters and numbers only).");
            return;
        }

        const githubRegex = /^https:\/\/github\.com\/[a-zA-Z0-9_-]+\/[a-zA-Z0-9_-]+(\/.*)?$/;
        if (!githubRegex.test(gitHubLink)) {
            alert("Please enter a valid GitHub link.");
            return;
        }

        // Prepare JSON payload
        const data = {
            name: name,
            gameTitle: gameTitle,
            gameDescrip: gameDescription,
            howToPlay: howToPlay,
            ETSUEmailPrefix: prefixInput,
            GitHubLink: gitHubLink
        };

        // Send JSON to the API
        fetch('/api/submission/submit-external', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(response => {
            if (response.ok) {
                document.getElementById("successMessage").style.display = "block";
            } else {
                alert("Failed to save game submission.");
            }
        })
        .catch(error => {
            console.error("Error:", error);
            alert("An error occurred while submitting the game.");
        });
    });
</script>
